# Copy outside the repository or inject these values from the deployment platform.
# Never commit the populated file. Compose rejects missing production-critical values.
COMPOSE_PROJECT_NAME=atos-staging
BACKEND_IMAGE=registry.example.invalid/ai-trading-os-backend:immutable-release-tag
FRONTEND_IMAGE=registry.example.invalid/ai-trading-os-frontend:immutable-release-tag
SERVICE_NAME=ai-trading-os-staging
RELEASE_ID=git-immutable-release-sha
DATABASE_URL=postgresql+psycopg://reference-only-use-platform-secret-injection
REDIS_URL=rediss://reference-only-use-platform-secret-injection
BACKEND_CORS_ORIGINS=https://staging.example.invalid
OIDC_ISSUER=https://identity.example.invalid/
OIDC_USERINFO_URL=https://identity.example.invalid/userinfo
OIDC_CLIENT_ID=replace-with-non-secret-client-id
OIDC_ROLE_CLAIM=role
AUTH_SESSION_SECRET_REF=aws-sm://replace-with-secret-id
LEGACY_TENANT_USER_ID=replace-with-existing-owner-oidc-sub
ERROR_REPORTING_ENABLED=true
NOTIFICATION_WEBHOOK_ALLOWED_HOSTS=alerts.example.invalid
EXTERNAL_LLM_CALLS_ENABLED=false
OPENAI_API_KEY_REF=
OPENAI_MODEL=gpt-4.1-mini
DEEPSEEK_API_KEY_REF=
DEEPSEEK_MODEL=deepseek-chat
LLM_PROVIDER_ALLOWLIST_RAW=openai:gpt-4.1-mini
# Fill only from an operator-reviewed pricing snapshot; otherwise cost remains unknown.
AI_PRICING_VERSION=
OPENAI_INPUT_COST_PER_MILLION_USD=
OPENAI_OUTPUT_COST_PER_MILLION_USD=
DEEPSEEK_INPUT_COST_PER_MILLION_USD=
DEEPSEEK_OUTPUT_COST_PER_MILLION_USD=
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
